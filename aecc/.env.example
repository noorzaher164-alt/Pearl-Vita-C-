# Session signing secret — REQUIRED in production. Generate with: openssl rand -hex 32
AECC_SESSION_SECRET=

# Optional: switch the data layer from the bundled sample store to Supabase.
# When all three are set, the Supabase adapter is used instead of the local store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
